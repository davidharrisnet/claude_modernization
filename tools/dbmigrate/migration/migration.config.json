{
  "source": {
    "server": "(localdb)\\MSSQLLocalDB",
    "database": "aspnet-MasterAntiqueRepair-e93a6129-7f74-4486-97e8-8d4ab1a709b4"
  },
  "outputDir": "tools/dbmigrate/export",
  "targets": {
    "sqlite": {
      "dialect": "sqlite",
      "iteration": 1,
      "iterationTitle": "SQLite on Windows",
      "outputSubdir": "iteration1",
      "reportDir": "docs/dbmigrate/iteration1",
      "guideFile": "SQLiteDatabaseGuide1.docx",
      "exe": "C:\\Apps\\sqlite-tools-win-x64-3530400\\sqlite3.exe",
      "diffExe": "C:\\Apps\\sqlite-tools-win-x64-3530400\\sqldiff.exe",
      "file": "tools/dbmigrate/export/iteration1/masterantique.sqlite"
    },
    "sqlite-linux": {
      "dialect": "sqlite",
      "iteration": 2,
      "iterationTitle": "SQLite in a Dockerized Linux container",
      "runner": {
        "mode": "docker",
        "container": "mar-sqlite",
        "image": "alpine:3.20",
        "autoStart": true
      },
      "file": "/data/masterantique.sqlite"
    },
    "mysql": {
      "dialect": "mysql",
      "runner": {
        "mode": "docker",
        "container": "mar-mysql",
        "image": "mysql:8.4",
        "autoStart": true
      },
      "database": "masterantique",
      "user": "root",
      "passwordEnv": "MAR_MYSQL_PASSWORD"
    }
  }
}
