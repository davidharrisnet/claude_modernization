# import-oracle settings (bash key=value, read by ingest.sh). Non-secret: the tool uses no password (SYS by operating-system
# authentication inside the container; the schema has none), and the start-up passwords are random and never stored or printed.
# Copy to ingest.conf to change anything; without ingest.conf, ingest.sh uses exactly these defaults.

# Docker container that holds the database (the database lives only in this container).
CONTAINER=mar-oracle
# Oracle AI Database 26ai Free (release 23.26.3), community image with the database prebuilt (ready in about 30 seconds).
ORA_IMAGE=gvenzl/oracle-free:23.26.3-faststart
# Pluggable database (service) the application schema lives in.
ORA_PDB=FREEPDB1
# Application schema, created as a schema-only account (NO AUTHENTICATION: nobody can log in as it).
ORA_USER=masterantique
# Folder with 01-schema.sql, 02-data-sanitized.sql and source-metadata.json (relative to this folder, or absolute).
INPUT_DIR=input
